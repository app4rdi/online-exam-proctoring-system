# Database Configuration
DB_HOST=localhost           # Use 'mysql' for Docker, 'localhost' for local dev
DB_USER=root                # Use 'proctoruser' for Docker
DB_PASSWORD=                # Use strong password for Docker/production
DB_NAME=proctor

# Flask Configuration
SECRET_KEY=your_very_secret_key_here_change_in_production
FLASK_ENV=development       # development or production
PORT=8080

# MySQL Root Password (for docker-compose only)
MYSQL_ROOT_PASSWORD=rootpassword

# Optional: Redis Configuration (if using caching)
REDIS_HOST=localhost        # Use 'redis' for Docker
REDIS_PORT=6379
